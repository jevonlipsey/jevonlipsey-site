---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE.name,
  description = 'Ph.D. Student in Human-Robot Interaction at Colorado School of Mines (MIRRORLab). Researching social robotics, neurosymbolic AI, and computational redistricting.',
} = Astro.props;

import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { SITE } from '../site.config';
---

<!doctype html>
<html lang="en" class="dark bg-background selection:bg-foreground selection:text-background">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@jevonlipsey" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Jevon Lipsey — thoughts" href="/feed.xml" />

    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        var dark = stored ? stored === 'dark' : true;
        document.documentElement.classList.toggle('dark', dark);

        window.addEventListener('storage', (e) => {
          if (e.key === 'theme') {
            document.documentElement.classList.toggle('dark', e.newValue === 'dark');
            document.dispatchEvent(new Event('themechange'));
          }
        });
      })();
    </script>

    <!-- Cloudflare Web Analytics -->
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "3f84f93f30de4cd090277aa17d230508"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </head>
  <body
    class="bg-background text-foreground flex flex-col min-h-[100dvh] overflow-x-hidden antialiased font-sans"
  >
    <div class="site-vignette" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">skip to content</a>
    <Navbar />

    <main id="main-content" class:list={['page-shell', { 'home-shell': Astro.url.pathname === '/' }]} tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-row">
        <span>&copy; {new Date().getFullYear()} {SITE.name.toLowerCase()}</span>
        <div class="footer-socials" aria-label="Social profiles">
          <a href={SITE.socials.instagram} target="_blank" rel="noreferrer">instagram ↗</a>
          <a href={SITE.socials.linkedin} target="_blank" rel="noreferrer">linkedin ↗</a>
        </div>
        <a href="/about" class="ink-bleed-link">about &amp; background ↗</a>
      </div>
    </footer>
  </body>
</html>
