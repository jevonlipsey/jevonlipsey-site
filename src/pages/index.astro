---
import Layout from '../layouts/Layout.astro';
import ImmersiveScene from '../components/ImmersiveScene';
import { SITE } from '../site.config';
import { getCollection } from 'astro:content';
import BibtexButton from '../components/BibtexButton';
import StatusBadge from '../components/StatusBadge.astro';
import ProjectLinks from '../components/ProjectLinks.astro';

const sortedResearch = (await getCollection('research')).sort((a, b) => b.data.year - a.data.year);
const recentThoughts = (await getCollection('thoughts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="jevon lipsey.">
  <section
    class="hero-section relative min-h-[100svh] w-full flex flex-col justify-center px-6 md:px-12 overflow-hidden"
    aria-labelledby="hero-title"
    style="isolation: isolate"
  >
    <!-- LAYER 1: 3D canvas, absolute backdrop --->
    <ImmersiveScene client:load />

    <!-- LAYER 2: exclusion cutout -->
    <h1
      id="hero-title"
      class="relative z-20 hero-title text-white font-sans font-bold tracking-[-0.04em] leading-[0.88] select-none pointer-events-none"
    >
      jevon<br />lipsey.
    </h1>

    <!-- LAYER 3: bio + links, interactive, below the title -->
    <div class="hero-copy relative z-30 mt-4 max-w-md pointer-events-auto bg-transparent">
      <p class="hero-bio"><strong>Human-robot interaction. Helluva engineer.</strong><br />
        Ph.D. researcher at Colorado School of Mines, advised under Dr. Tom Williams in the MIRROЯLab.</p>
      <div class="hero-links" aria-label="Profile links">
        <a class="ink-bleed-link" href={SITE.links.cv} target="_blank" rel="noreferrer">cv ↗</a>
        <a class="ink-bleed-link" href={SITE.links.github} target="_blank" rel="noreferrer">github ↗</a>
        <a class="ink-bleed-link" href={SITE.links.scholar} target="_blank" rel="noreferrer">scholar ↗</a>
        <a class="ink-bleed-link" href={`mailto:${SITE.emails.personal}`}>email ↗</a>
        <!-- gyro chip portals into this slot from immersive scene (touch devices only) -->
        <span id="hero-links-slot"></span>
      </div>
    </div>
  </section>
  <!-- about section -->
  <div class="research-intro relative group reveal" style="--i: 0">
    <a href="/about" class="absolute inset-0 z-10" aria-label="Read more about Jevon Lipsey"></a>
    <span class="about-label flex justify-between items-center w-full">
      about
      <span class="opacity-0 group-hover:opacity-100 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300">↗</span>
    </span>
    <p>I study how people interact with conversational robots in civic settings like public libraries and classrooms. My work explores how physical embodiment shapes perceived judgment and engagement, investigating where robots meaningfully expand accessibility and where human relationships should never be replaced.</p>
  </div>

  <section class="home-section" aria-labelledby="research-title">
    <div class="section-heading">
      <h2 id="research-title">
        <a class="section-heading-link" href="/research">
          <span class="heading-label">selected research</span>
          <span class="heading-arrow" aria-hidden="true">↗</span>
        </a>
      </h2>
    </div>
    <div class="publication-list">
      {sortedResearch.map((paper, index) => (
        <article class="publication pub-card relative group reveal" style={`--i: ${index}`}>
          <!-- hit area for the entire card -->
          <a href={`/research/${paper.id}`} class="absolute inset-0 z-10" aria-label={`Read ${paper.data.title}`}></a>
          <div class="publication-meta flex flex-wrap gap-x-3 gap-y-1 items-center">
            <span class="pub-year font-mono text-xs text-neutral-400">{paper.data.year}</span>
            {(paper.data.acronyms.length ? paper.data.acronyms : [paper.data.venue]).map((badge) => (
              <span class="venue-badge font-mono text-xs text-neutral-400" title={paper.data.venue}>{badge}</span>
            ))}
            <StatusBadge status={paper.data.status} />
          </div>
          <div>
            <h3><a class="ink-bleed-link" href={`/research/${paper.id}`}>{paper.data.title}</a></h3>
            <p class="publication-authors">{paper.data.authors.map((author, index) => (
              <span>{/lipsey/i.test(author) ? <strong class="font-medium text-foreground">{author}</strong> : author}{index < paper.data.authors.length - 1 && ', '}</span>
            ))}</p>
            <p class="publication-abstract">{paper.data.abstract}</p>
            <div class="publication-actions relative z-20">
              <a class="ink-bleed-link" href={`/research/${paper.id}`}>[read note]</a>
              {paper.data.pdf && <a class="ink-bleed-link" href={paper.data.pdf} target="_blank" rel="noreferrer">[pdf]</a>}
              {paper.data.code && <a class="ink-bleed-link" href={paper.data.code} target="_blank" rel="noreferrer">[code]</a>}
              {paper.data.bibtex && <BibtexButton client:load bibtex={paper.data.bibtex} title={paper.data.title} />}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="systems-title">
    <div class="section-heading">
      <h2 id="systems-title">
        <a class="section-heading-link" href="/projects">
          <span class="heading-label">software &amp; systems</span>
          <span class="heading-arrow" aria-hidden="true">↗</span>
        </a>
      </h2>
    </div>
    <div class="project-grid">
      {featuredProjects.map((project, index) => {
          const { github, demo, appstore, caseStudy } = project.data.links;
          const primary = github ?? demo ?? appstore ?? caseStudy;
          const primaryInternal = primary === caseStudy;
          const primaryAttrs = primaryInternal ? { href: primary } : { href: primary, target: '_blank', rel: 'noreferrer' };
          return (
            <article class="project-card relative reveal" style={`--i: ${index}`}>
              {primary && <a {...primaryAttrs} class="card-hit-area" aria-label={`Open ${project.data.title}`}></a>}
              {project.data.metric && <span class="project-metric">{project.data.metric}</span>}
              <h3>{primary ? <a class="ink-bleed-link" {...primaryAttrs}>{project.data.title} ↗</a> : project.data.title}</h3>
              <ProjectLinks links={project.data.links} />
              <p>{project.data.desc}</p>
              <div class="project-tags">{project.data.tech.map((tag) => <span class="project-tag">{tag}</span>)}</div>
            </article>
          );
        })}
    </div>
  </section>

  {recentThoughts.length > 0 && (
    <section class="home-section" aria-labelledby="thoughts-title">
      <div class="section-heading">
        <h2 id="thoughts-title">
          <a class="section-heading-link" href="/thoughts">
            <span class="heading-label">thoughts</span>
            <span class="heading-arrow" aria-hidden="true">↗</span>
          </a>
        </h2>
      </div>
      <div class="thoughts-list">
        {recentThoughts.map((post, index) => (
          <article class="thoughts-entry reveal" style={`--i: ${index}`}>
            <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
            <div><a class="ink-bleed-link" href={`/thoughts/${post.id}`}>{post.data.title}</a></div>
          </article>
        ))}
      </div>
    </section>
  )}
</Layout>

<script>
  document.documentElement.classList.add('reveal-active');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealEls = Array.from(document.querySelectorAll('.reveal'));
  if (reduceMotion || !('IntersectionObserver' in window)) {
    revealEls.forEach((el) => el.classList.add('revealed'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );
    revealEls.forEach((el) => io.observe(el));
  }
</script>
