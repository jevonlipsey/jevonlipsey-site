---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import BibtexButton from '../components/BibtexButton';

const allResearch = await getCollection('research');
const sortedResearch = allResearch.sort((a, b) => b.data.year - a.data.year);

const allThoughts = await getCollection('thoughts');
const recentThoughts = allThoughts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const projects = [
  {
    title: 'Pocket8',
    subtitle: 'iOS PICO-8 WebAssembly Companion',
    tech: 'WebAssembly, Swift, Vue.js',
    desc: 'Officially licensed PICO-8 mobile companion app built in collaboration with Lexaloffle Games (6,000+ downloads). Modifies Emscripten boot sequence to bridge WebAssembly with iOS file systems and compressed memory snapshotting.',
    link: 'https://github.com/jevonlipsey',
  },
  {
    title: 'FeatherWeight',
    subtitle: 'eBird Observation Probability Model',
    tech: 'FastAPI, Python, Vue.js, SQLite',
    desc: 'Scraping and statistical ranking engine modeling historical observation likelihoods to guide ornithological field observation without requiring raw statistical interpretation.',
    link: 'https://github.com/jevonlipsey',
  },
  {
    title: 'Total Community Preservation',
    subtitle: 'COI Redistricting Dual Graph Analysis',
    tech: 'Python, GeoPandas, GerryChain MCMC',
    desc: 'Adapted HHI formulation quantifying community of interest fractures across 20M+ Markov chain redistricting steps, demonstrating strategic sensitivity in Colorado legislative boundaries.',
    link: 'https://github.com/jevonlipsey',
  },
];
---

<Layout title="Jevon Lipsey">
  <div class="space-y-16">

    <!-- 1. Hero & Bio -->
    <section class="space-y-6">
      <div class="space-y-2">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-foreground">
          Jevon Lipsey
        </h1>
        <p class="text-base text-zinc-300 font-normal">
          Ph.D. Student in Human-Robot Interaction at Colorado School of Mines (MIRROЯLab)
        </p>
      </div>

      <p class="text-base text-zinc-400 leading-relaxed max-w-2xl">
        I research Human-Robot Interaction under Dr. Tom Williams, focusing on community-grounded social robotics, embodied agency, and algorithmic fairness. My past work spans published neurosymbolic AI (AAAI-25, PMLR 2025), computational redistricting using MCMC ensembles, and full-stack software systems.
      </p>

      <!-- Action Links -->
      <div class="flex flex-wrap items-center gap-4 text-sm font-mono pt-1">
        <a
          href="/cv.pdf"
          target="_blank"
          class="text-zinc-200 hover:text-white underline underline-offset-4 decoration-zinc-700 hover:decoration-zinc-300 transition-colors"
        >
          CV (PDF)
        </a>
        <span class="text-zinc-600">&bull;</span>
        <a
          href="https://github.com/jevonlipsey"
          target="_blank"
          rel="noreferrer"
          class="text-zinc-400 hover:text-white transition-colors"
        >
          GitHub
        </a>
        <span class="text-zinc-600">&bull;</span>
        <a
          href="https://scholar.google.com"
          target="_blank"
          rel="noreferrer"
          class="text-zinc-400 hover:text-white transition-colors"
        >
          Google Scholar
        </a>
        <span class="text-zinc-600">&bull;</span>
        <a
          href="mailto:jevon_lipsey@mines.edu"
          class="text-zinc-400 hover:text-white transition-colors"
        >
          Email
        </a>
      </div>
    </section>

    <!-- 2. Selected Research -->
    <section class="space-y-6">
      <div class="border-b border-border/40 pb-2 flex items-baseline justify-between">
        <h2 class="text-sm font-mono uppercase tracking-wider text-muted-foreground">
          Selected Research
        </h2>
        <a href="/research" class="text-xs font-mono text-zinc-500 hover:text-zinc-300 transition-colors">
          all publications &rarr;
        </a>
      </div>

      <div class="space-y-8">
        {sortedResearch.map((paper) => (
          <article class="space-y-2">
            <div class="font-mono text-xs text-zinc-500">
              {paper.data.year} &bull; {paper.data.venue}
              {paper.data.status === 'in-review' && (
                <span class="ml-2 text-zinc-400 font-mono text-[11px]">(Under Review)</span>
              )}
            </div>

            <h3 class="text-base font-medium text-foreground">
              <a
                href={`/research/${paper.id}`}
                class="hover:underline underline-offset-4"
              >
                {paper.data.title}
              </a>
            </h3>

            <!-- Authors list with Jevon Lipsey highlighted -->
            <p class="text-sm text-zinc-400 leading-snug">
              {paper.data.authors.map((author, index) => (
                <span>
                  {author === 'Jevon Lipsey' ? (
                    <strong class="font-semibold text-zinc-200">{author}</strong>
                  ) : (
                    <span>{author}</span>
                  )}
                  {index < paper.data.authors.length - 1 && ', '}
                </span>
              ))}
            </p>

            <p class="text-sm text-zinc-400 leading-relaxed pt-1">
              {paper.data.abstract}
            </p>

            <div class="flex items-center gap-3 pt-1 text-xs font-mono text-zinc-500">
              <a
                href={`/research/${paper.id}`}
                class="hover:text-zinc-200 transition-colors"
              >
                [read summary]
              </a>
              {paper.data.pdf && (
                <a
                  href={paper.data.pdf}
                  target="_blank"
                  rel="noreferrer"
                  class="hover:text-zinc-200 transition-colors"
                >
                  [pdf]
                </a>
              )}
              {paper.data.code && (
                <a
                  href={paper.data.code}
                  target="_blank"
                  rel="noreferrer"
                  class="hover:text-zinc-200 transition-colors"
                >
                  [code]
                </a>
              )}
              {paper.data.bibtex && (
                <BibtexButton client:load bibtex={paper.data.bibtex} title={paper.data.title} />
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 3. Projects & Systems -->
    <section class="space-y-6">
      <div class="border-b border-border/40 pb-2 flex items-baseline justify-between">
        <h2 class="text-sm font-mono uppercase tracking-wider text-muted-foreground">
          Selected Projects &amp; Systems
        </h2>
        <a href="/demos" class="text-xs font-mono text-zinc-500 hover:text-zinc-300 transition-colors">
          demos &rarr;
        </a>
      </div>

      <div class="space-y-6">
        {projects.map((proj) => (
          <div class="space-y-1.5">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-sm font-medium text-foreground">
                <a
                  href={proj.link}
                  target="_blank"
                  rel="noreferrer"
                  class="hover:underline underline-offset-4"
                >
                  {proj.title}
                </a>
                <span class="font-normal text-zinc-400 ml-2">&mdash; {proj.subtitle}</span>
              </h3>
              <span class="font-mono text-xs text-zinc-500 shrink-0">{proj.tech}</span>
            </div>
            <p class="text-sm text-zinc-400 leading-relaxed">
              {proj.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Recent Writing -->
    {recentThoughts.length > 0 && (
      <section class="space-y-6">
        <div class="border-b border-border/40 pb-2 flex items-baseline justify-between">
          <h2 class="text-sm font-mono uppercase tracking-wider text-muted-foreground">
            Writing
          </h2>
          <a href="/thoughts" class="text-xs font-mono text-zinc-500 hover:text-zinc-300 transition-colors">
            all posts &rarr;
          </a>
        </div>

        <div class="space-y-4">
          {recentThoughts.map((post) => (
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 sm:gap-4">
              <a
                href={`/thoughts/${post.id}`}
                class="text-sm font-medium text-zinc-300 hover:text-white hover:underline underline-offset-4"
              >
                {post.data.title}
              </a>
              <span class="font-mono text-xs text-zinc-500 whitespace-nowrap">
                {post.data.date.toISOString().slice(0, 10)}
              </span>
            </div>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>
