---
import Layout from '../layouts/Layout.astro';
import ImmersiveScene from '../components/ImmersiveScene';
import { getCollection } from 'astro:content';
import BibtexButton from '../components/BibtexButton';

const sortedResearch = (await getCollection('research')).sort((a, b) => b.data.year - a.data.year);
const recentThoughts = (await getCollection('thoughts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const projects = [
  {
    title: 'pocket8',
    metric: '6,000+ downloads',
    tech: ['webassembly', 'swift', 'vue.js'],
    desc: 'Officially licensed PICO-8 mobile companion built with Lexaloffle Games. Bridges WebAssembly memory snapshots with native iOS file systems.',
    link: 'https://github.com/jevonlipsey',
  },
  {
    title: 'ocean sweep',
    metric: 'computer vision + physical control',
    tech: ['UbiComp', 'three.js', 'micro:bit'],
    desc: 'An ocean cleanup game steered with hand gestures and a physical Micro:bit controller. Webcam vision meets accelerometer input over Web Serial.',
    link: 'https://github.com/jevonlipsey',
  },
  {
    title: 'total community preservation',
    metric: '20m+ mcmc steps',
    tech: ['python', 'geopandas', 'gerrychain'],
    desc: 'Measuring community-of-interest fractures across Colorado legislative boundaries with a dual-graph pipeline and Markov chain redistricting simulations.',
    link: 'https://github.com/jevonlipsey',
  },
  {
    title: 'featherweight',
    metric: 'ebird observation engine',
    tech: ['fastapi', 'python', 'sqlite'],
    desc: 'Historical observation data turned into likelihood estimates that help birders decide where to look next.',
    link: 'https://github.com/jevonlipsey',
  },
];
---

<Layout title="Jevon Lipsey | Human-Robot Interaction">
  <section
    class="hero-section relative min-h-[100svh] w-full flex flex-col justify-center px-6 md:px-12 overflow-hidden"
    aria-labelledby="hero-title"
    style="isolation: isolate"
  >
    <!-- LAYER 1: 3D canvas, absolute backdrop (rendered by the island) -->
    <ImmersiveScene client:load />

    <!-- LAYER 2: pure exclusion cutout, DIRECT SIBLING of the canvas, no wrappers -->
    <h1
      id="hero-title"
      class="relative z-20 hero-title text-white font-sans font-bold tracking-[-0.04em] leading-[0.88] select-none pointer-events-none"
    >
      jevon<br />lipsey.
    </h1>

    <!-- LAYER 3: bio + links, interactive, below the title -->
    <div class="hero-copy relative z-30 mt-4 max-w-md pointer-events-auto bg-transparent">
      <p class="hero-bio"><strong>Human-robot interaction researcher.</strong><br />
        Ph.D. student at Colorado School of Mines, advised by Dr. Tom Williams.</p>
      <div class="hero-links" aria-label="Profile links">
        <a class="ink-bleed-link" href="/cv.pdf" target="_blank" rel="noreferrer">cv ↗</a>
        <a class="ink-bleed-link" href="https://github.com/jevonlipsey" target="_blank" rel="noreferrer">github ↗</a>
        <a class="ink-bleed-link" href="https://scholar.google.com" target="_blank" rel="noreferrer">scholar ↗</a>
        <a class="ink-bleed-link" href="mailto:jevon_lipsey@mines.edu">email ↗</a>
      </div>
    </div>
  </section>

  <div class="research-intro relative group hover:bg-black/5 dark:hover:bg-white/5 transition-colors rounded-2xl p-6 -mx-6">
    <a href="/about" class="absolute inset-0 z-10" aria-label="Read more about Jevon Lipsey"></a>
    <span class="about-label flex justify-between items-center w-full">
      about
      <span class="opacity-0 group-hover:opacity-100 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300">↗</span>
    </span>
    <p>I study how physical agents navigate human and spatial boundaries, through community-grounded social robotics, embodied agency, and algorithmic fairness.</p>
  </div>

  <section class="home-section" aria-labelledby="research-title">
    <div class="section-heading">
      <h2 id="research-title">selected research</h2>
      <a class="ink-bleed-link" href="/research">all publications ↗</a>
    </div>
    <div class="publication-list">
      {sortedResearch.map((paper) => (
        <article class="publication pub-card relative group">
          <!-- dedicated stretched-link hit area for the entire card -->
          <a href={`/research/${paper.id}`} class="absolute inset-0 z-10" aria-label={`Read ${paper.data.title}`}></a>
          <div class="publication-meta flex flex-wrap gap-x-3 gap-y-1 items-center">
            <span class="pub-year font-mono text-xs text-neutral-400">{paper.data.year}</span>
            <span class="venue-badge font-mono text-xs text-neutral-400" title={paper.data.venue}>{paper.data.venue.match(/\b(HRI|AAAI|PMLR)\b/)?.[0] ?? paper.data.venue}</span>
            {paper.data.status === 'in-review' && <span class="status-badge font-mono text-xs text-amber-400/90">[under review]</span>}
          </div>
          <div>
            <h3><a class="ink-bleed-link" href={`/research/${paper.id}`}>{paper.data.title}</a></h3>
            <p class="publication-authors">{paper.data.authors.map((author, index) => (
              <span>{author === 'Jevon Lipsey' ? <strong class="font-medium text-foreground">{author}</strong> : author}{index < paper.data.authors.length - 1 && ', '}</span>
            ))}</p>
            <p class="publication-abstract">{paper.data.abstract}</p>
            <div class="publication-actions relative z-20">
              <a class="ink-bleed-link" href={`/research/${paper.id}`}>[read note]</a>
              {paper.data.pdf && <a class="ink-bleed-link" href={paper.data.pdf} target="_blank" rel="noreferrer">[pdf]</a>}
              {paper.data.code && <a class="ink-bleed-link" href={paper.data.code} target="_blank" rel="noreferrer">[code]</a>}
              {paper.data.bibtex && <BibtexButton client:load bibtex={paper.data.bibtex} title={paper.data.title} />}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="systems-title">
    <div class="section-heading">
      <h2 id="systems-title">software &amp; systems</h2>
      <a class="ink-bleed-link" href="/projects">projects ↗</a>
    </div>
    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card relative">
          <!-- dedicated stretched-link hit area for the entire card -->
          <a href={project.link} target="_blank" rel="noreferrer" class="card-hit-area" aria-label={`Open ${project.title}`}></a>
          <span class="project-metric">{project.metric}</span>
          <h3><a class="ink-bleed-link" href={project.link} target="_blank" rel="noreferrer">{project.title} ↗</a></h3>
          <p>{project.desc}</p>
          <div class="project-tags">{project.tech.map((tag) => <span class="project-tag">{tag}</span>)}</div>
        </article>
      ))}
    </div>
  </section>

  {recentThoughts.length > 0 && (
    <section class="home-section" aria-labelledby="writing-title">
      <div class="section-heading">
        <h2 id="writing-title">writing</h2>
        <a class="ink-bleed-link" href="/thoughts">all writing ↗</a>
      </div>
      <div class="writing-list">
        {recentThoughts.map((post) => (
          <article class="writing-entry">
            <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
            <div><a class="ink-bleed-link" href={`/thoughts/${post.id}`}>{post.data.title}</a></div>
          </article>
        ))}
      </div>
    </section>
  )}
</Layout>
