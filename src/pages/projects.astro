---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Projects | Jevon Lipsey" description="Interactive systems, WebGL experiments, and ubiquitous computing by Jevon Lipsey.">
  <div class="space-y-12">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-foreground mb-2">Projects</h1>
      <p class="text-base text-muted-foreground">
        Interactive software systems, WebGL experiments, and hardware interfaces.
      </p>
    </div>

    <div class="space-y-8">
      <div class="space-y-6">
        {projects.map((item) => (
          <article class="project-card relative">
            <!-- dedicated stretched-link hit area for the entire card -->
            <a href={item.data.link} target="_blank" rel="noreferrer" class="card-hit-area" aria-label={`Open ${item.data.title}`}></a>
            <div class="flex flex-wrap items-baseline justify-between gap-4 mb-1">
              <h3 class="text-foreground">
                {item.data.title}
              </h3>
              <a
                href={item.data.link}
                target="_blank"
                rel="noreferrer"
                class="ink-bleed-link font-mono text-xs shrink-0"
              >
                source &rarr;
              </a>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed mb-3">
              {item.data.desc}
            </p>
            <div class="flex flex-wrap gap-2 text-xs font-mono">
              {item.data.tech.map((t) => (
                <span class="project-tag">{t}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>
