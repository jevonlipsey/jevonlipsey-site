---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BibtexButton from '../../components/BibtexButton';

export async function getStaticPaths() {
  const papers = await getCollection('research');
  return papers.map((paper) => ({
    params: { id: paper.id },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const { Content } = await render(paper);
---

<Layout title={`${paper.data.title} | Jevon Lipsey`} description={paper.data.abstract}>
  <div class="space-y-8">
    <div class="space-y-3">
      <a href="/research" class="text-xs font-mono text-zinc-500 hover:text-zinc-300 transition-colors inline-block">
        &larr; all publications
      </a>

      <div class="font-mono text-xs text-zinc-500">
        {paper.data.year} &bull; {paper.data.venue}
        {paper.data.status === 'in-review' && (
          <span class="ml-2 text-zinc-400 font-mono text-[11px]">(Under Review)</span>
        )}
      </div>

      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-foreground">
        {paper.data.title}
      </h1>

      <p class="text-sm text-zinc-400 leading-relaxed">
        {paper.data.authors.map((author, idx) => (
          <span>
            {author === 'Jevon Lipsey' ? (
              <strong class="font-semibold text-zinc-200">{author}</strong>
            ) : (
              <span>{author}</span>
            )}
            {idx < paper.data.authors.length - 1 && ', '}
          </span>
        ))}
      </p>

      <!-- Action Links -->
      <div class="flex items-center gap-4 pt-2 text-xs font-mono">
        {paper.data.pdf && (
          <a
            href={paper.data.pdf}
            target="_blank"
            rel="noreferrer"
            class="text-zinc-300 hover:text-white underline underline-offset-4 decoration-zinc-700 hover:decoration-zinc-300 transition-colors"
          >
            [pdf paper]
          </a>
        )}
        {paper.data.code && (
          <a
            href={paper.data.code}
            target="_blank"
            rel="noreferrer"
            class="text-zinc-400 hover:text-white transition-colors"
          >
            [code repository]
          </a>
        )}
        {paper.data.bibtex && (
          <BibtexButton client:load bibtex={paper.data.bibtex} title={paper.data.title} />
        )}
      </div>
    </div>

    <!-- Abstract Box -->
    <div class="p-4 rounded-md border border-border/60 bg-card/40 space-y-2">
      <h2 class="text-xs font-mono uppercase tracking-wider text-muted-foreground">Abstract</h2>
      <p class="text-sm text-zinc-300 leading-relaxed">
        {paper.data.abstract}
      </p>
    </div>

    <!-- Rendered Markdown Body -->
    <div class="prose prose-invert prose-zinc max-w-none text-sm leading-relaxed space-y-4 pt-4 border-t border-border/40">
      <Content />
    </div>
  </div>
</Layout>
