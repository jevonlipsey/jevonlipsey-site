---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import BibtexButton from '../components/BibtexButton';
const sortedPubs = (await getCollection('research')).sort((a, b) => b.data.year - a.data.year);
---

<Layout title="Research | Jevon Lipsey" description="Publications and manuscripts in Human-Robot Interaction, neurosymbolic AI, and redistricting.">
  <div class="space-y-12">
    <div class="space-y-4">
      <h1 class="font-semibold">Research &amp; publications</h1>
      <p class="text-muted-foreground">Peer-reviewed publications, student abstracts, and manuscripts under review.</p>
    </div>
    <div class="space-y-10">
      {sortedPubs.map((pub) => (
        <article class="pub-card space-y-4 border-t border-border pt-7">
          <div class="font-mono text-xs flex flex-wrap gap-x-3 gap-y-1 items-center">
            <span class="pub-year text-neutral-400">{pub.data.year}</span>
            {(pub.data.acronyms.length ? pub.data.acronyms : [pub.data.venue]).map((badge, i) => (
              <span key={i} class="venue-badge text-neutral-400" title={pub.data.venue}>{badge}</span>
            ))}
            {pub.data.status === 'in-review' && <span class="status-badge text-amber-400/90">[under review]</span>}
          </div>
          <h2 class="text-xl sm:text-2xl font-medium tracking-tight">
            <a href={`/research/${pub.id}`} class="ink-bleed-link">{pub.data.title}</a>
          </h2>
          <p class="text-sm text-muted-foreground leading-relaxed">
            {pub.data.authors.map((author, index) => (
              <span>{/lipsey/i.test(author) ? <strong class="font-medium text-foreground">{author}</strong> : author}{index < pub.data.authors.length - 1 && ', '}</span>
            ))}
          </p>
          <p class="text-sm text-muted-foreground leading-relaxed">{pub.data.abstract}</p>
          <div class="publication-actions">
            <a href={`/research/${pub.id}`} class="ink-bleed-link">[read paper summary]</a>
            {pub.data.pdf && <a href={pub.data.pdf} target="_blank" rel="noreferrer" class="ink-bleed-link">[pdf]</a>}
            {pub.data.code && <a href={pub.data.code} target="_blank" rel="noreferrer" class="ink-bleed-link">[code]</a>}
            {pub.data.bibtex && <BibtexButton client:load bibtex={pub.data.bibtex} title={pub.data.title} />}
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
