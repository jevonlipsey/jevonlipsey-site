---
import Layout from '../layouts/Layout.astro';
import ThoughtsArchive from '../components/ThoughtsArchive';
import { getCollection } from 'astro:content';

const posts = (await getCollection('thoughts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const thoughts = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  date: p.data.date.toISOString().slice(0, 10),
  summary: p.data.summary,
  tags: p.data.tags,
  url: `/thoughts/${p.id}`,
}));
---

<Layout title="Thoughts | Jevon Lipsey" description="Field notes on robotics, computing ethics, and software engineering.">
  <div class="space-y-10">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-foreground mb-2">Thoughts</h1>
      <p class="text-base text-muted-foreground">
        Essays, notes, and observations on HRI, research methodology, and systems.
      </p>
    </div>

    <div class="space-y-8">
      <ThoughtsArchive client:load posts={thoughts} />
    </div>
  </div>
</Layout>
